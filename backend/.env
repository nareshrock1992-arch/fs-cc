# ── Dev backend .env ──────────────────────────────────────────────────────────
# Used when running "npm run dev" directly (not via Docker).
# Docker Compose ignores this file and uses the root .env instead.

PORT=4000
NODE_ENV=development

# CORS: allow the Vite dev server (frontend running on localhost:5173)
# Comma-separated — admin UI on 5173 AND agent desktop on 8080
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# PostgreSQL — running locally
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fs_cc
DB_USER=fs_cc
DB_PASSWORD=changeme

# FreeSWITCH ESL — your local or LAN FreeSWITCH server
FS_ESL_HOST=127.0.0.1
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon
FS_ESL_RECONNECT_MS=3000

JWT_SECRET=dev-only-insecure-secret-change-for-production

# FreeSWITCH SIP domain — IP/FQDN of the FS internal SIP profile.
# Used to build internal agent contact strings: {sip_cid_type=pid}user/<ext>@<FS_SIP_DOMAIN>
# Dev: Tailscale IP of the FreeSWITCH server (internal-tailscal.xml sip-ip)
# Production: supplied via fs-cp deploy/.env SIP_DOMAIN → FS_SIP_DOMAIN (see docker-compose.yml)
FS_SIP_DOMAIN=100.93.232.116
